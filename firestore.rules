rules_version = '2';

// The public site can only CREATE well-formed documents in two collections. Nothing can be read,
// listed, updated or deleted from a client; every other path is denied. Data is read in the Firebase
// console (which bypasses these rules). Limits mirror src/lib/validate.ts: change both together.
service cloud.firestore {
  match /databases/{database}/documents {

    function isString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max && v.trim().size() > 0;
    }

    // Basic shape, plus: no leading, trailing or doubled dots in either part, and a 2+ character TLD.
    function validEmail(v) {
      return isString(v, 5, 254)
        && v.matches('^[^@\\s.]+(\\.[^@\\s.]+)*@[^@\\s.]+(\\.[^@\\s.]+)*\\.[^@\\s.]{2,}$');
    }

    function hasExactly(keys) {
      return request.resource.data.keys().hasAll(keys)
        && request.resource.data.keys().hasOnly(keys);
    }

    function stampedNow() {
      return request.resource.data.createdAt == request.time;
    }

    // "Get notified". The document ID is the lowercased email, so a second sign-up with the same
    // address is an update, and is denied.
    match /notified/{email} {
      allow read, update, delete: if false;
      allow create: if hasExactly(['name', 'email', 'college', 'createdAt'])
        && isString(request.resource.data.name, 1, 100)
        && isString(request.resource.data.college, 1, 150)
        && validEmail(request.resource.data.email)
        && request.resource.data.email == email
        && email == email.lower()
        && stampedNow();
    }

    // Everything else, for everyone.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
